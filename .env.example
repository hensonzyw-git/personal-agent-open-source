# Model credentials. Keep real values outside Git.
ZAI_API_KEY=
ANTHROPIC_API_KEY=

# Active chat/aux model provider (see src/personal_agent/runtime/model_providers.py).
# Unset or empty means zhipu. Switching to DeepSeek needs:
#   MODEL_PROVIDER=deepseek
#   DEEPSEEK_API_KEY=<key>
#   MODEL_ID=deepseek-flash   (lowercase; ids are case-sensitive)
# Dotted business tool names are sanitized per request (ToolNameMapper);
# verified live 2026-09-05 (docs/evidence/). Model id updated 2026-09-10:
# V4.1 Flash renamed the id to deepseek-flash; old v4 names are routed
# there temporarily.
#MODEL_PROVIDER=
#DEEPSEEK_API_KEY=

# Chat model id and OpenAI-compatible endpoint for the ADK adapter.
# Env renamed 2026-09-10: GLM_MODEL -> MODEL_ID, GLM_OPENAI_BASE_URL ->
# MODEL_API_BASE (the registry picks the pinned endpoint when unset).
MODEL_API_BASE=https://open.bigmodel.cn/api/paas/v4/
MODEL_ID=glm-5.3-flash

# GLM Anthropic-compatible endpoint used by the Claude Agent SDK adapter.
ANTHROPIC_BASE_URL=https://open.bigmodel.cn/api/anthropic
ANTHROPIC_DEFAULT_HAIKU_MODEL=glm-4.7
ANTHROPIC_DEFAULT_SONNET_MODEL=glm-5.2
ANTHROPIC_DEFAULT_OPUS_MODEL=glm-5.2

# DEV-031: the Feishu ledger URL the service names to enrolled devices for the
# review card's "打开飞书账本" jump. Keep the real app_token out of Git.
PERSONAL_AGENT_LEDGER_URL=https://example.feishu.cn/base/<app_token>

# Multimodal remains OFF until its separate approval and live acceptance gates.
# To compose storage, install its protected lock set and supply EVERY ceiling
# below from the deployment resource budget. No production defaults are invented.
# PERSONAL_AGENT_MEDIA_ROOT=
# PERSONAL_AGENT_MEDIA_MAX_CONTENT_BYTES=
# PERSONAL_AGENT_MEDIA_MAX_DIMENSION=
# PERSONAL_AGENT_MEDIA_ALLOWED_MIMES=image/jpeg
# PERSONAL_AGENT_MEDIA_TARGET_TTL_SECONDS=
# PERSONAL_AGENT_MEDIA_CLAIM_TTL_SECONDS=
# PERSONAL_AGENT_MEDIA_RETENTION_TTL_SECONDS=
# PERSONAL_AGENT_MEDIA_IMAGE_PIXELS_PER_TOKEN=
# PERSONAL_AGENT_MEDIA_MAX_TOTAL_BYTES=
# PERSONAL_AGENT_MEDIA_MAX_UNBOUND_OBJECTS=
# PERSONAL_AGENT_MEDIA_MAX_CONCURRENT_UPLOADS=
# PERSONAL_AGENT_MEDIA_IMAGE_INPUT=off
