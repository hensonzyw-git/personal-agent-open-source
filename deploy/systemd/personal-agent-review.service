# DEV-036: the daily Finance review job. See src/personal_agent/review_cli.py.
#
# Runs as the API service user because the job signs a Host Context to read the
# Finance control plane (`PERSONAL_AGENT_SERVICE_ACTIVE_*`), and the Agent
# database it writes review cards into is the API's 0700 data dir. No model, no
# MCP session, no Feishu call, no data key: the CLI composes only the control
# reader. Idempotent on `review_date`, so a repeat fire (a timer race, a manual
# rerun, a Persistent catch-up after downtime) adds nothing.
[Unit]
Description=Personal Agent daily Finance review cards
After=personal-data-mcp.service

[Service]
Type=oneshot
User=personal-agent-api
Group=personal-agent-api
EnvironmentFile=/etc/personal-agent/api.env
ExecStart=/opt/personal-agent/.venv/bin/personal-agent-review \
    --database /var/lib/personal-agent-api/agent.sqlite \
    --finance-control-url http://127.0.0.1:8811
# The review job writes rows: cards, notification outbox. ProtectSystem=strict
# plus this one writable path is the same shape as the API service.
ReadWritePaths=/var/lib/personal-agent-api
TimeoutStartSec=300s

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
# loopback only, to the Finance control API.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
