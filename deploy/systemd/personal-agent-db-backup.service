# DEV-035: snapshot the Agent API database (Online Backup API) into staging.
#
# Runs as the Agent service user against its own 0700 data dir. The backup user
# cannot read the live DB or media root, so this service prepares one immutable
# bundle itself; the backup user only verifies and ships that bundle.
[Unit]
Description=Personal Agent API DB snapshot for offsite backup
After=personal-agent-api.service

[Service]
Type=oneshot
User=personal-agent-api
Group=personal-agent-api
# 0027, not 0077: the staged files exist to be read by personal-agent-backup,
# which reaches them through the setgid staging dir's group. 0077 makes every
# staged file owner-only, so the offsite backup can stat them and open none.
UMask=0027
EnvironmentFile=/etc/personal-agent/api.env
ExecStart=/opt/personal-agent/.venv/bin/personal-agent-media-backup-bundle prepare --database /var/lib/personal-agent-api/agent.sqlite --stage-root /var/backups/personal-agent/api
TimeoutStartSec=300s

ReadWritePaths=/var/backups/personal-agent/api
ReadOnlyPaths=/var/lib/personal-agent-api

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
