# DEV-035: snapshot the Agent API database (Online Backup API) into staging.
#
# Runs as the Agent service user against its own 0700 data dir. The backup user
# cannot read the live DB, so the service produces the snapshot itself; the
# backup user only reads the staged file. Also exports the deletion manifest
# (sealed ids only) so a restore can replay it independently of the snapshot.
[Unit]
Description=Personal Agent API DB snapshot for offsite backup
After=personal-agent-api.service

[Service]
Type=oneshot
User=personal-agent-api
Group=personal-agent-api
UMask=0077
ExecStart=/opt/personal-agent/.venv/bin/personal-agent-db \
    --database /var/lib/personal-agent-api/agent.sqlite \
    backup --out /var/backups/personal-agent/api/agent.latest.sqlite
# Export the deletion manifest the restore must replay. Sealed ids only; the
# output is its own small file the restic backup carries separately from the
# DB snapshot, so replay does not depend on the snapshot's own table copy.
ExecStartPost=/opt/personal-agent/.venv/bin/personal-agent-export-deletion-manifest \
    --database /var/lib/personal-agent-api/agent.sqlite \
    --out /var/backups/personal-agent/api/deletion-manifest.json
TimeoutStartSec=300s

ReadWritePaths=/var/backups/personal-agent/api
ReadOnlyPaths=/var/lib/personal-agent-api

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
