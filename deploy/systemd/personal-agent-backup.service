# DEV-035: ship the staged snapshots + config + deletion manifest to OSS via
# restic, then prune. See deploy/backup.sh for the policy and the fail-closed
# checks.
#
# Runs as the personal-agent-backup user, which is in BOTH service groups so it
# can read the staged snapshots in /var/backups/personal-agent. It never reads
# the live 0700 databases (those dirs are 0700 owner-only) and never reads a
# secret: restic.env is root:backup 0640, and the repo password file is root
# only, reached through RESTIC_PASSWORD_FILE.
[Unit]
Description=Personal Agent offsite backup (restic -> OSS)
After=personal-agent-db-backup.service personal-data-mcp-db-backup.service
Requires=personal-agent-db-backup.service personal-data-mcp-db-backup.service

[Service]
Type=oneshot
User=personal-agent-backup
Group=personal-agent-backup
SupplementaryGroups=personal-agent-api personal-data-mcp
EnvironmentFile=/etc/personal-agent/restic.env
ExecStart=/opt/personal-agent/deploy/backup.sh
TimeoutStartSec=1800s

# Read the staged snapshots and the unit files; write only the restic cache.
# The live data dirs are 0700 and not listed here, so even the group membership
# cannot reach them through this unit's filesystem view.
ReadOnlyPaths=/var/backups/personal-agent /etc/systemd/system
ReadWritePaths=/var/cache/restic
PrivateTmp=yes

NoNewPrivileges=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
# restic talks to OSS over HTTPS.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
