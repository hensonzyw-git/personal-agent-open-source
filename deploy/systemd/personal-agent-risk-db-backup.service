# Snapshot the risk monitor database (Online Backup API) into staging.
#
# Runs as the Agent service user against the 0700 data dir it shares with the
# risk monitor (risk_monitor.db lives next to agent.sqlite). The backup user
# cannot read the live DB, so the service produces the snapshot itself; the
# backup user only reads the staged file. Mirrors personal-agent-db-backup, minus
# the deletion-manifest export (the risk DB has no deletion manifest).
[Unit]
Description=Personal Agent risk monitor DB snapshot for offsite backup
After=personal-agent-risk.service

[Service]
Type=oneshot
User=personal-agent-api
Group=personal-agent-api
# 0027, not 0077: the staged file exists to be read by personal-agent-backup
# through the setgid staging dir's group.
UMask=0027
ExecStart=/opt/personal-agent/.venv/bin/risk-monitor-db \
    --database /var/lib/personal-agent-api/risk_monitor.db \
    backup --out /var/backups/personal-agent/api/risk_monitor.latest.sqlite
TimeoutStartSec=300s

ReadWritePaths=/var/backups/personal-agent/api
ReadOnlyPaths=/var/lib/personal-agent-api

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
