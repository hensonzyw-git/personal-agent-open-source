[Unit]
Description=Personal Agent DAL GitHub unknown-effect reconciliation sweep
After=personal-agent-dal-api.service
Requires=personal-agent-dal-api.service

[Service]
Type=oneshot
User=personal-agent-dal
Group=personal-agent-dal
UMask=0077
ExecStart=/opt/personal-agent-dal/.venv/bin/personal-agent-dal-console \
    --base-url http://127.0.0.1:8820 \
    --service-key-file /etc/personal-agent/dal.env.d/service-key \
    --timeout 30 \
    reconcile-sweep

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
