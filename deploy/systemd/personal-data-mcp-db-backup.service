# DEV-035: snapshot the Finance MCP database (Online Backup API) into staging.
#
# Runs as the Finance service user against its own 0700 data dir. The backup
# user cannot read the live DB, so the service produces the snapshot itself.
[Unit]
Description=Personal Data MCP DB snapshot for offsite backup
After=personal-data-mcp.service

[Service]
Type=oneshot
User=personal-data-mcp
Group=personal-data-mcp
# 0027, not 0077: see personal-agent-db-backup.service. The staged snapshot is
# written to be read by the backup user via the setgid staging dir's group.
UMask=0027
ExecStart=/opt/personal-agent/.venv/bin/personal-data-mcp-db \
    --database /var/lib/personal-data-mcp/finance.sqlite \
    backup --out /var/backups/personal-agent/mcp/finance.latest.sqlite
# Stage the protected ledger config too. It lives in the 0700 live data dir, so
# the backup user can never read it there -- restic tried on 2026-08-01 and got
# EPERM after it had already written a partial snapshot. A restore needs the
# config that was in force, so it is staged like the snapshot: written by the
# owning service, 0640, group-inherited from the setgid staging dir.
ExecStartPost=/usr/bin/install -m 0640 \
    /var/lib/personal-data-mcp/ledger.synthetic_test.2026.json \
    /var/backups/personal-agent/mcp/ledger.synthetic_test.2026.json
TimeoutStartSec=300s

ReadWritePaths=/var/backups/personal-agent/mcp
ReadOnlyPaths=/var/lib/personal-data-mcp

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
