[Unit]
# DEV-032. Design 3.2: the Finance MCP listens on loopback TCP only; it is
# never proxied by Nginx and never reachable from the public network.
Description=Personal Data MCP (Finance, loopback only)
After=network-online.target
Wants=network-online.target
# These two belong to [Unit] since systemd v229. Left in [Service] they travel a
# deprecation path, and a version that drops it leaves `Restart=on-failure` with
# no rate limit at all — a fail-closed service would then spin forever.
StartLimitIntervalSec=120s
StartLimitBurst=5

[Service]
Type=simple
User=personal-data-mcp
Group=personal-data-mcp
UMask=0077
# DEV-039: the external-write kill switch. Declared in the unit rather than in
# the env file, because the env files hold secrets and are edited by hand: this
# path is a safety control and belongs in version-controlled configuration. The
# service refuses to start if it is unset, so the setting cannot be lost quietly.
Environment=PERSONAL_AGENT_WRITE_SWITCH_FILE=/etc/personal-agent/write-switch.json
# DEV-040 §13.2: the per-breakpoint fault-injection pause for the live chaos
# drill. Same treatment as the write switch: version-controlled path, service
# refuses to start if unset. The file itself is absent in the disarmed position
# (no file means no pause), and is only written during a drill.
Environment=PERSONAL_AGENT_FAULT_BREAKPOINT_FILE=/etc/personal-agent/fault-breakpoint.json
EnvironmentFile=/etc/personal-agent/mcp.env
ExecStart=/opt/personal-agent/.venv/bin/personal-data-mcp \
    --database /var/lib/personal-data-mcp/finance.sqlite \
    --ledger-config /var/lib/personal-data-mcp/ledger.synthetic_test.2026.json \
    --host 127.0.0.1 \
    --port 8811
Restart=on-failure
RestartSec=5s

# Created by deploy/install.sh as personal-data-mcp:personal-data-mcp 0700.
ReadWritePaths=/var/lib/personal-data-mcp

# Technical design §10.1 sandbox baseline.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
