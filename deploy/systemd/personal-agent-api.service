[Unit]
# DEV-032. Design 3.2: the Client API listens on a Unix socket behind Nginx;
# only Nginx (www-data) may connect, so the socket's group is www-data while
# the data directory stays reachable only by the service user.
Description=Personal Agent Client API (single-user, behind Nginx)
After=network-online.target personal-data-mcp.service
Wants=network-online.target
Requires=personal-data-mcp.service
# `personal-data-mcp` is Type=simple, so "active" means forked, not listening.
# The API fails closed when the MCP is not answering yet, so the boot-order race
# is resolved by restarting rather than by a readiness protocol — the budget
# below is therefore wide enough that a slow MCP start cannot exhaust it.
StartLimitIntervalSec=300s
StartLimitBurst=10

[Service]
Type=simple
User=personal-agent-api
# The socket's group must be www-data so only Nginx can connect to it. That
# makes www-data the *primary* group, which means the service would otherwise
# lose the `personal-agent-api` gid entirely: `useradd --system` leaves the
# group's member list in /etc/group empty, so `initgroups()` cannot restore it
# from the passwd primary gid that `Group=` has just overridden. Without this
# line the process cannot traverse /etc/personal-agent/keys/api (0750
# root:personal-agent-api) and fails to start on its first key read.
Group=www-data
SupplementaryGroups=personal-agent-api
# uvicorn hardcodes a fresh UDS to mode 0666 and ignores umask (it calls
# os.chmod(uds, 0o666) after binding; verified against the installed uvicorn
# 2026-07-31), so the access boundary is the RuntimeDirectory below
# (0770 api:www-data), not the socket file mode. UMask therefore only shapes
# the database files under /var/lib -- and those must NOT be group-readable.
#
# `Group=www-data` above makes www-data this process's egid, and
# /var/lib/personal-agent-api is not setgid, so every file it creates
# (agent.sqlite, -wal, -shm) is group www-data. At 0007 that handed Nginx --
# the one network-facing process on this box -- read+write on the Agent
# database, with only the directory's 0700 standing in the way. 0077 makes them
# 0600 and costs nothing: nothing but this service ever opens them, and the
# socket's mode does not come from here.
UMask=0077
# DEV-039: the external-write kill switch. Declared in the unit rather than in
# the env file, because the env files hold secrets and are edited by hand: this
# path is a safety control and belongs in version-controlled configuration. The
# service refuses to start if it is unset, so the setting cannot be lost quietly.
Environment=PERSONAL_AGENT_WRITE_SWITCH_FILE=/etc/personal-agent/write-switch.json
# The full-fidelity turn transcript (2026-08-14). Every message's model input,
# raw model output, dispatched tool call, tool outcome and returned body land
# in this directory as plaintext JSONL, mode 0600 -- unlike `conversation_events`,
# which are sealed. Henson chose plaintext deliberately so a turn can be grepped
# and replayed into an eval set without a key, and bounded the exposure with
# this switch plus retention instead of encryption.
#
# It lives in the unit rather than in api.env for the same reason as the write
# switch above: it is a privacy control, so turning it on or off must be a
# visible, version-controlled act. Comment the directory line out and restart
# to stop recording; the independent daily personal-agent-cleanup timer keeps
# deleting files past the retention window even while capture is off.
#
# The path must stay under ReadWritePaths below, and is deliberately NOT one of
# deploy/backup.sh's inputs: a transcript is disposable diagnostic material and
# has no place in an off-machine snapshot.
Environment=PERSONAL_AGENT_TRANSCRIPT_DIR=/var/lib/personal-agent-api/transcripts
Environment=PERSONAL_AGENT_TRANSCRIPT_RETENTION_DAYS=14
EnvironmentFile=/etc/personal-agent/api.env
ExecStart=/opt/personal-agent/.venv/bin/personal-agent-api \
    --database /var/lib/personal-agent-api/agent.sqlite \
    --socket /run/personal-agent/api.sock \
    --finance-mcp-url http://127.0.0.1:8811/mcp \
    --finance-control-url http://127.0.0.1:8811
Restart=on-failure
RestartSec=5s

# Socket directory, chowned to personal-agent-api:www-data by systemd. It is
# the access boundary for the API: only Nginx's group can reach the socket
# inside, whose own mode uvicorn sets to 0666.
RuntimeDirectory=personal-agent
RuntimeDirectoryMode=0770
# The data directory is created by deploy/install.sh as
# personal-agent-api:personal-agent-api mode 0700; declared writable here
# because ProtectSystem=strict makes the rest of the hierarchy read-only.
ReadWritePaths=/var/lib/personal-agent-api

# Technical design §10.1 sandbox baseline.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
