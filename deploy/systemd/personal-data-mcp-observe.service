# DEV-034: the health/alert one-shot. See src/personal_data_mcp/observe_cli.py.
#
# Runs as personal-data-mcp because the data directory is 0700 and owned by it:
# an observer running as anyone else would need root, which would give up the
# isolation DEV-032 exists to provide. It reads and never writes.
[Unit]
Description=Personal Agent health check (durable facts, journald alerts)
After=personal-data-mcp.service

[Service]
Type=oneshot
User=personal-data-mcp
Group=personal-data-mcp
ExecStart=/opt/personal-agent/.venv/bin/personal-data-mcp-observe \
    --database /var/lib/personal-data-mcp/finance.sqlite \
    --backup-marker /var/lib/personal-agent-backup/last-successful-backup \
    --backup-monitor-start /var/lib/personal-agent-backup/monitoring-started-at
# Exit 1 (found problems) and exit 2 (could not check) both mark the unit
# failed, which is the alert. They stay distinct in the journal line, so
# `systemctl status` shows which happened.
TimeoutStartSec=120s

# Read-only: this must never be able to modify what it reports on.
ProtectSystem=strict
ReadOnlyPaths=/var/lib/personal-data-mcp
# DEV-036: the backup-success marker, written by the backup unit. Read-only
# here; the observer never writes it.
ReadOnlyPaths=/var/lib/personal-agent-backup
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
