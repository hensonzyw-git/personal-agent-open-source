    {
      "name": "finance.update_family_fund",
      "version": "1.0.0",
      "domain": "finance",
      "effect": "update",
      "risk_level": "R2",
      "enabled": true,
      "disabled_reason": null,
      "summary": "家庭基金充值，或按目标余额补齐利息；只记账本变动，不执行资金划转。",
      "model_input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "FinanceUpdateFamilyFundInput",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "mode"
        ],
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "top_up",
              "interest_reconcile"
            ],
            "description": "top_up 直接充值；interest_reconcile 由用户给出当前目标余额，服务端读取当前余额后计算差值的一半。"
          },
          "recharge_amount_cny": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,2})?$",
            "description": "top_up 模式的充值金额，必须为正数。",
            "default": null,
            "not": {
              "enum": [
                "0",
                "0.0",
                "0.00"
              ]
            }
          },
          "target_balance_cny": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,2})?$",
            "description": "interest_reconcile 模式的目标余额。低于或等于当前余额时不写入。",
            "default": null
          },
          "note": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 80,
            "default": null,
            "description": "备注；利息补齐的备注由服务端固定写入，不由模型提供。"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "mode": {
                  "const": "top_up"
                }
              },
              "required": [
                "mode"
              ]
            },
            "then": {
              "required": [
                "recharge_amount_cny"
              ],
              "properties": {
                "recharge_amount_cny": {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,2})?$",
                  "description": "top_up 模式的充值金额，必须为正数。",
                  "not": {
                    "enum": [
                      "0",
                      "0.0",
                      "0.00"
                    ]
                  }
                },
                "target_balance_cny": {
                  "const": null
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "mode": {
                  "const": "interest_reconcile"
                }
              },
              "required": [
                "mode"
              ]
            },
            "then": {
              "required": [
                "target_balance_cny"
              ],
              "properties": {
                "target_balance_cny": {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,2})?$"
                },
                "recharge_amount_cny": {
                  "const": null
                },
                "note": {
                  "const": null
                }
              }
            }
          }
        ]
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
