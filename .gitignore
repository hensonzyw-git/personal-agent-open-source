# OS and editor files
.DS_Store
.idea/
.qoder/*
!.qoder/rules/
!.qoder/tool-profiles.md
.vscode/
.venv/
.pytest_cache/
__pycache__/
*.py[cod]
*.egg-info/

# Secrets and certificates
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
# APNs auth keys. Apple lets you download a `.p8` exactly once and never again,
# which makes the natural instinct — keep a copy somewhere handy — point
# straight at the repo.
*.p8
secrets/
# The off-machine key copies deliberately live OUTSIDE this repo, in
# ~/.personal-agent/secrets/ -- see docs/密钥清单_v0.1.md. `secrets/` stays
# ignored anyway, because a key that lands here even briefly must never be
# committable: the application data keys cannot be reissued (rotating one does
# not make already-sealed rows readable again), and publishing one would also
# publish what opens every backup sitting in OSS.

# Protected server-side ledger configuration. It carries Base, table and field
# identifiers, which are sensitive though not secret; only the redacted report
# may be committed.
config/

# Personal data, exports, backups, and runtime state
backups/
data/
health-exports/
*.sqlite
*.sqlite3
*.db
*.log

# iOS build artefacts. The app sources, the package and the shared scheme are
# committed; SwiftPM/Xcode output and per-user Xcode state are not.
ios/**/.build/
ios/build/
ios/**/.swiftpm/
ios/**/*.xcodeproj/project.xcworkspace/
ios/**/*.xcodeproj/xcuserdata/
DerivedData/

# Agent worktrees. Scratch checkouts of this same repository: the commits live
# on their branches, so tracking the directories would vendor the repo into
# itself.
.claude/worktrees/
