<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Simulator only, applied through `CODE_SIGN_ENTITLEMENTS[sdk=iphonesimulator*]`.

	  A simulator build made without a signing team gets no entitlements at all,
	  and the Keychain then refuses every call with errSecMissingEntitlement
	  (-34018) -- which looks exactly like a bug in the credential store. A device
	  build must NOT use this file: automatic signing supplies the real
	  `application-identifier` from team TESTTEAM01, and a hardcoded one here
	  would fight it. The device build uses `PersonalAgent/PersonalAgent.entitlements`
	  instead; the split is enforced by `CODE_SIGN_ENTITLEMENTS[sdk=iphonesimulator*]`
	  overriding the plain setting, verified with `-showBuildSettings` per sdk.

	  Deliberately no `aps-environment` here. The simulator has no APNs token to
	  give, so push registration cannot succeed on it, and claiming the
	  entitlement would only turn a clear "unsupported here" into a confusing
	  runtime failure. Push registration code must therefore treat the simulator
	  as a place where it does not run, not as an error.
	-->
	<key>application-identifier</key>
	<string>org.example.PersonalAgent</string>
	<key>keychain-access-groups</key>
	<array>
		<string>org.example.PersonalAgent</string>
	</array>
</dict>
</plist>
